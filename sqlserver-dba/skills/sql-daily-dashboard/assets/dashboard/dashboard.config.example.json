{
  "title": "SQL Server daily workload",
  "server": "your-sql-server",
  "environment": "Production (read-only)",
  "baselineDate": "2026-01-15",
  "baselineNote": "A known-good, steady day",
  "topN": 30,
  "databases": [
    { "name": "YourMainDb", "groups": "groups_yoursite.sql", "main": true },
    { "name": "SecondDb" }
  ],
  "extra": [
    { "key": "business", "database": "YourMainDb", "sql": "business_yoursite.sql" }
  ],
  "candidates": "findings-ledger.md",
  "drill": {
    "skill": "sqlserver-performance-analysis",
    "scripts": "C:\\path\\to\\sqlserver-performance-analysis\\scripts"
  },
  "thresholds": {
    "cpuPctWarn": 60, "cpuPctAlert": 80,
    "risingRatio": 1.5, "risingMinCpuMin": 10,
    "regressionRatio": 2.0,
    "qsPctWarn": 80, "qsPctAlert": 90,
    "compilesWarn": 100,
    "errorsJumpRatio": 1.3
  },
  "outDir": "out"
}
